{
  "schema_version": 3,
  "plugin_id": "dev.ouro.examples.review_driver",
  "name": "Review Run Driver",
  "namespace": "review_driver",
  "version": "0.1.0",
  "engines": {"ouro": "^0.2.0", "plugin_api": "^3.0.0"},
  "runtime": {"kind": "python-inprocess", "entrypoint": "review_driver_plugin:create_plugin"},
  "permissions": [
    {"id": "sessions.write", "reason": "Execute a user-selected Run algorithm through native ports."},
    {"id": "background.run", "reason": "Accept review command input into the native Run queue."}
  ],
  "contributes": {
    "run_drivers": [{"id": "review"}],
    "commands": [{"id": "review", "description": "Review and execute a request", "requires_session": true}]
  }
}
