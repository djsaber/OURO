{
  "schema_version": 3,
  "plugin_id": "dev.ouro.examples.worker_tool",
  "name": "Worker Tool Example",
  "version": "0.1.0",
  "description": "Contributes a Tool through the strict stdio worker protocol.",
  "namespace": "worker_tool",
  "engines": {
    "ouro": ">=0.3.0,<0.4.0",
    "plugin_api": "^3.0.0"
  },
  "runtime": {
    "kind": "worker",
    "command": [
      "{python}",
      "./worker.py"
    ],
    "protocol": "3.0"
  },
  "contributes": {
    "tools": [
      {
        "id": "echo",
        "exposed_name": "worker_example__echo",
        "description": "Echo a value and track the call in this Session's state.",
        "effect": "state_changing",
        "batch_behavior": "exclusive",
        "permission_mode": "approval"
      }
    ]
  },
  "permissions": [],
  "dependencies": {
    "plugins": []
  },
  "metadata": {}
}
